ARG BASE=mrf-component:local
FROM ${BASE}
WORKDIR /app
COPY components /app/components
COPY matching /app/matching
COPY task_repr /app/task_repr
COPY resources /app/resources
COPY scheduler /app/scheduler
COPY task_executor /app/task_executor
COPY shared /app/shared
COPY deployment /app/deployment
RUN pip install --no-index --find-links=/app/deployment/checkpoint-wheels 'jsonschema>=4.20,<5'
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "deployment.worker"]
